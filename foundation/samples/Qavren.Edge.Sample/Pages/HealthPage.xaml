<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Qavren.Edge.Sample.Pages.HealthPage"
             Title="Health">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label x:Name="InfoLabel" FontFamily="Consolas" LineBreakMode="WordWrap" />
            <Label x:Name="CheckLabel" FontFamily="Consolas" LineBreakMode="WordWrap" />
            <Button Text="Checkpoint" Clicked="OnCheckpoint" />
            <Label x:Name="CheckpointLabel" FontFamily="Consolas" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
