<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Linux CI hosts can only ever get the android workload: the iOS and Mac Catalyst SDK
		     packs do not exist for linux-x64 (NETSDK1178) and the Windows TFM needs a Windows host.
		     Restore evaluates EVERY entry of TargetFrameworks for every project in the graph, so
		     leaving them listed fails `dotnet test -f net10.0-android` before a test can run. The
		     linux lane only ever builds the android device lane, so that is all it needs. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">net10.0-android</TargetFrameworks>
		<!-- Same restore-evaluates-every-TFM rule on macOS hosts: the Windows TFM needs a Windows
		     host (NETSDK1100), so the apple and maccatalyst lanes drop it. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Qavren.Edge.Sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Qavren.Edge.Sample</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>app.qavren.edge.sample</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Raised from 15.0 (SP4 plan adjustment 8 / Task 7.2): the sample now references
		     Qavren.Edge.Chat.Onnx, and Microsoft.ML.OnnxRuntimeGenAI's managed asset group is
		     net9.0-ios15.4 with its xcframework slices built at that floor. Qavren.Edge.DeviceTests
		     and the tier-0 device head carry the same 15.4 for the same reason. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.4</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.4</SupportedOSPlatformVersion>
		<!-- Raised from 21.0 (ADR 0008 / Task 7.1): the sample now references Qavren.Edge.Onnx, whose
		     ORT 1.30.0 AAR declares minSdkVersion 24, and .NET for Android merges library manifests
		     into the app's. Task 7.1 measured the manifest-merge failure at 21.0 on
		     Qavren.Edge.DeviceTests against the identical AAR; the same failure applies here for the
		     same reason, so the sample's own floor moves with it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- SP4 spec 12.4 / Task 7.2: the two iOS entitlements a multi-GB memory-mapped model needs
		     (increased-memory-limit, extended-virtual-addressing). They are plist lines in the APP,
		     not code in a library; Qavren.Edge.Chat.Onnx writes nobody's entitlements file, and this
		     sample setting both is how a consumer discovers they need them. Mac Catalyst keeps its
		     own template-issued Entitlements.plist, which the SDK picks up by convention.
		     DEVICE ONLY: both entitlements mean nothing on a simulator, and a non-empty
		     CodesignEntitlements makes the DetectSigningIdentity task demand a keychain identity
		     hosted CI has none of (PR #18, device-tests-ios "Build sample (ios)"). The simulator
		     case is handled by the _QedgeDropSimulatorEntitlements target at the bottom of this
		     file, NOT by a condition here: _SdkIsSimulator is computed in Xamarin.Shared.Sdk.props,
		     which the workload SDK imports AFTER this body (and after Directory.Build.targets), so
		     it is always empty during static evaluation of this property. -->
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>

		<!-- XA0141 (android head only): ORT GenAI 0.15.2's AAR ships libmat.so without 16 KB page
		     alignment, which Android 16 requires. Upstream's to fix; every GenAI consumer sees it.
		     Kept VISIBLE as a warning (WarningsNotAsErrors, not NoWarn) but exempted from
		     -warnaserror, exactly as Qavren.Edge.DeviceTests does, so the wave-close solution build
		     is not broken by a package this sample cannot change. See chat/README.md. -->
		<WarningsNotAsErrors Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(WarningsNotAsErrors);XA0141</WarningsNotAsErrors>
	</PropertyGroup>

	<!-- Spec 15: the Encryption page toggles the native package by BUILD CONFIGURATION.
	     `Cipher` is a release-like configuration that swaps Qavren.Edge.Sqlite.Native for
	     Qavren.Edge.Sqlite.Native.Cipher and defines QEDGE_CIPHER. Referencing both packages in
	     one app is a configuration error the startup pipeline rejects, so this must be an
	     either/or at build time, never a runtime switch. -->
	<PropertyGroup>
		<Configurations>Debug;Release;Cipher</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Cipher'">
		<QedgeCipher>true</QedgeCipher>
		<Optimize>true</Optimize>
		<DefineConstants>$(DefineConstants);QEDGE_CIPHER</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Qavren.Edge.Maui\Qavren.Edge.Maui.csproj" />
		<ProjectReference Include="..\..\src\Qavren.Edge.Sqlite\Qavren.Edge.Sqlite.csproj" />
	</ItemGroup>

	<!-- Task 7.2 / spec 18: the three SP2 packages behind the Embeddings and Search pages. -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\embeddings\src\Qavren.Edge.Onnx\Qavren.Edge.Onnx.csproj" />
		<ProjectReference Include="..\..\..\embeddings\src\Qavren.Edge.Embeddings.Onnx\Qavren.Edge.Embeddings.Onnx.csproj" />
		<ProjectReference Include="..\..\..\embeddings\src\Qavren.Edge.VectorData\Qavren.Edge.VectorData.csproj" />

		<!-- SP3's Ingest page (plan Task 8.2). The core plus the three satellites this sample calls:
		     .Onnx for AddOnnxIngestion (the tokenizer and the throttle over SP2's resource monitor),
		     .Pdf and .OpenXml for AddPdfExtractor/AddDocxExtractor. NOT .DataIngestion - the sample
		     does not use MEDI and that package is prerelease-only. All four are net10.0 and this
		     project is multi-TFM over the four platform heads; a platform TFM consuming a net10.0
		     library is ordinary TFM compatibility, and the sample already resolves ORT's platform
		     asset through Qavren.Edge.Embeddings.Onnx, so no SupportedOSPlatformVersion moves. -->
		<ProjectReference Include="..\..\..\ingestion\src\Qavren.Edge.Ingestion\Qavren.Edge.Ingestion.csproj" />
		<ProjectReference Include="..\..\..\ingestion\src\Qavren.Edge.Ingestion.Onnx\Qavren.Edge.Ingestion.Onnx.csproj" />
		<ProjectReference Include="..\..\..\ingestion\src\Qavren.Edge.Ingestion.Pdf\Qavren.Edge.Ingestion.Pdf.csproj" />
		<ProjectReference Include="..\..\..\ingestion\src\Qavren.Edge.Ingestion.OpenXml\Qavren.Edge.Ingestion.OpenXml.csproj" />
	</ItemGroup>

	<!-- SP4 Task 7.2 / spec 18: the two SP4 packages behind the Chat and Ask pages. Qavren.Edge.Rag
	     is net10.0-only and references no ONNX package; Qavren.Edge.Chat.Onnx is what brings the
	     GenAI natives onto each head. -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\chat\src\Qavren.Edge.Chat.Onnx\Qavren.Edge.Chat.Onnx.csproj" />
		<ProjectReference Include="..\..\..\chat\src\Qavren.Edge.Rag\Qavren.Edge.Rag.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(QedgeCipher)' == 'true'">
		<ProjectReference Include="..\..\src\Qavren.Edge.Sqlite.Native.Cipher\Qavren.Edge.Sqlite.Native.Cipher.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(QedgeCipher)' != 'true'">
		<ProjectReference Include="..\..\src\Qavren.Edge.Sqlite.Native\Qavren.Edge.Sqlite.Native.csproj" />
	</ItemGroup>

	<!-- Simulator builds carry no entitlements (see the CodesignEntitlements comment above). The
	     DetectSigningIdentity task reads $(CodesignEntitlements) and $(_SdkIsSimulator) when it
	     RUNS, so clearing the property here, before the targets that consume it, is what a static
	     condition cannot do. _CompileEntitlements depends on _DetectSigningIdentity; both are named
	     so this runs first whichever the build reaches first. -->
	<Target Name="_QedgeDropSimulatorEntitlements"
	        BeforeTargets="_DetectSigningIdentity;_CompileEntitlements"
	        Condition="'$(_SdkIsSimulator)' == 'true' and '$(CodesignEntitlements)' != ''">
		<Message Importance="normal" Text="Qavren.Edge.Sample: simulator build, dropping CodesignEntitlements '$(CodesignEntitlements)'." />
		<PropertyGroup>
			<CodesignEntitlements />
		</PropertyGroup>
	</Target>

</Project>
