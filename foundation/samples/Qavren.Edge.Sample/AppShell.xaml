<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Qavren.Edge.Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Qavren.Edge.Sample"
    xmlns:pages="clr-namespace:Qavren.Edge.Sample.Pages"
    Title="Qavren.Edge.Sample">

    <ShellContent
        Title="Diagnostics"
        ContentTemplate="{DataTemplate pages:DiagnosticsPage}"
        Route="DiagnosticsPage" />

    <ShellContent
        Title="Notes"
        ContentTemplate="{DataTemplate pages:NotesPage}"
        Route="NotesPage" />

    <ShellContent
        Title="Embeddings"
        ContentTemplate="{DataTemplate pages:EmbeddingsPage}"
        Route="EmbeddingsPage" />

    <!-- Before Search: the two read in the order a user performs them (plan Task 8.2). -->
    <ShellContent
        Title="Ingest"
        ContentTemplate="{DataTemplate pages:IngestPage}"
        Route="IngestPage" />

    <ShellContent
        Title="Search"
        ContentTemplate="{DataTemplate pages:SearchPage}"
        Route="SearchPage" />

    <ShellContent
        Title="Chat"
        ContentTemplate="{DataTemplate pages:ChatPage}"
        Route="ChatPage" />

    <ShellContent
        Title="Ask"
        ContentTemplate="{DataTemplate pages:AskPage}"
        Route="AskPage" />

    <ShellContent
        Title="Health"
        ContentTemplate="{DataTemplate pages:HealthPage}"
        Route="HealthPage" />

    <ShellContent
        Title="Encryption"
        ContentTemplate="{DataTemplate pages:EncryptionPage}"
        Route="EncryptionPage" />

</Shell>
